# ffdash configuration. Copy to .env and fill in. .env is never committed.

# Path to the SQLite file. Relative paths resolve from the repo root.
FFDASH_DB=db/ffdash.db

# Season to treat as current. Leave unset to infer from today's date.
# FFDASH_SEASON=2025

# Phase 5 only (paid player props). Phases 0-4 need no keys at all.
# ODDS_API_KEY=

# Set to 1 when the site is reachable by anyone other than you.
# Suppresses the NFL team logos (club trademarks) in favour of coloured
# initials badges. Attribution is shown either way -- both upstream data
# licences require it.
# FFDASH_PUBLIC=1
